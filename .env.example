#  许可：个人自用及 ≤10 人、年营收 ≤200 万元的小团队内部使用免费；
#        其余商业使用需向作者购买授权，详见 LICENSE 与 NOTICE。
# ============================================================

# ---------------- 端口划分 ----------------
# 管理端端口：只在内网访问（不要做公网端口转发、不要加进 WAF 规则）
ADMIN_PORT=8080
# 员工自助门户端口：只把这一个端口对公网开放（云服务器安全组 / 宝塔 WAF 反代到这里）
PUBLIC_PORT=8081
#
# ⚠ 改完端口必须重建容器，端口映射才会更新：
#     docker compose up -d --force-recreate
#   docker compose restart 不会重新创建容器，所以端口改了看着"没生效"。
#   查看实际生效的端口：docker compose ps

# 允许访问后端的前端来源（留空 = 不限制）。有公网域名时建议写成域名，例如 https://it.example.com
FRONTEND_ORIGIN=

# ---------------- 数据库（MariaDB 10.11） ----------------
# 说明：compose 里镜像用的是 mariadb:10.11，容器内变量名是 MARIADB_*，
#       但这里仍沿用 MYSQL_* 作为键名，老 .env 不必改名即可继续使用。
# ⚠ 这些口令只在**数据卷为空、首次初始化**时生效。
#   数据卷已经初始化过，改这里不会改掉数据库里的真实口令；
#   要改必须进容器执行 ALTER USER，或删卷重建（会丢数据）。
MYSQL_ROOT_PASSWORD=itops_root_2026
MYSQL_DATABASE=itops
MYSQL_USER=itops
MYSQL_PASSWORD=itops_2026

# ---------------- 后端 ----------------
# 生产环境务必改成随机长字符串（生成：openssl rand -hex 32）
JWT_SECRET=change_this_secret_in_prod

# 可选：固定二维码入口密钥（8~64 位字母/数字/-/_）。
# 密钥默认存在 MariaDB 数据卷里，重建容器、拉新代码、--force-recreate 都不会变；
# 只有管理员在设置页点「重置入口密钥」才会变。
# 若担心将来误删数据卷或换了部署目录导致密钥重新生成，可把当前设置页显示的
# 「入口密钥」原样填到这里，即使数据库全新初始化也会沿用同一个密钥，已打印的二维码不失效。
# 数据库里已有密钥时以数据库为准，此值只在「首次生成」时生效。
# REPORT_KEY=

# 首次启动自动创建的管理员初始口令（仅当用户表为空时生效）
# 登录后请立即在「系统设置 → 安全」中修改
DEFAULT_ADMIN_PASSWORD=admin123

# 本地 AI 服务地址别名：AI 服务跑在宿主机时，容器内用 host.docker.internal 访问
AI_LOCALHOST_ALIAS=host.docker.internal
